    },
    {
      "name": "priority:p1",
      "group": "priority",
      "color": "d93f0b",
      "description": "High priority within active sprint"
    },
    {
      "name": "priority:p2",
      "group": "priority",
      "color": "fbca04",
      "description": "Normal planned work"
    },
    {
      "name": "priority:p3",
      "group": "priority",
      "color": "c2e0c6",
      "description": "Backlog or optional improvement"
    },
    {
      "name": "risk:low",
      "group": "risk",
      "color": "0e8a16",
      "description": "Isolated, reversible, verified low-risk change"
    },
    {
      "name": "risk:medium",
      "group": "risk",
      "color": "fbca04",
      "description": "Cross-component review required"
    },
    {
      "name": "risk:high",
      "group": "risk",
      "color": "d93f0b",
      "description": "Security, data, authentication or significant integration risk"
    },
    {
      "name": "risk:production",
      "group": "risk",
      "color": "b60205",
      "description": "Potential live runtime or persistent-state impact"
    },
    {
      "name": "state:needs-evidence",
      "group": "state",
      "color": "fef2c0",
      "description": "Insufficient evidence to accept"
    },
    {
      "name": "state:blocked",
      "group": "state",
      "color": "b60205",
      "description": "Known unresolved dependency"
    },
    {
      "name": "state:ready-for-review",
      "group": "state",
      "color": "0e8a16",
      "description": "Acceptance evidence ready for reviewer"
    },
    {
      "name": "state:approved",
      "group": "state",
      "color": "0e8a16",
      "description": "Explicit approval recorded; not equivalent to merged"
    },
    {
      "name": "migration:assess",
      "group": "migration",
      "color": "bfd4f2",
      "description": "Inventory and feasibility assessment"
    },
    {
      "name": "migration:consumer-check",
      "group": "migration",
      "color": "bfd4f2",
      "description": "Verify live callers and dependencies"
    },
    {
      "name": "migration:parity",
      "group": "migration",
      "color": "bfd4f2",
      "description": "Confirm source/target functional parity"
    },
    {
      "name": "migration:cutover-proposed",
      "group": "migration",
      "color": "f9d0c4",
      "description": "Controlled cutover proposed; not approved"
    },
    {
      "name": "migration:rollback-ready",
      "group": "migration",
      "color": "c2e0c6",
      "description": "Rollback pathway tested and documented"
    }
  ],
  "compatibility": {
    "existing_labels": "Preserve current repo-specific labels including Chatgpt area/apps and area/packages",
    "migration_from_v1": {
      "status:needs-evidence": "state:needs-evidence",
      "status:blocked": "state:blocked",
      "status:ready-for-review": "state:ready-for-review",
      "migration:assessment": "migration:assess",
      "migration:cutover-proposal": "migration:cutover-proposed"
    },
    "do_not_auto_relabel": true
  },
  "constraints": {
    "work_type": "Exactly one type per PR",
    "work_area": "One or more as relevant",
    "priority": "At most one",
    "risk": "Exactly one for migration/cutover; risk:production is a specific impact flag, not severity order",
    "state": "At most one; native GitHub PR status remains authoritative",
    "migration": "One current stage or multiple verified gates only where meaningful"
  }
}
