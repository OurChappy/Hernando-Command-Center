{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OurChappy offline cycle export",
  "type": "object",
  "required": [
    "schema_version",
    "cycle_id",
    "source",
    "stages",
    "mode",
    "external_writes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "filename",
        "sha256"
      ],
      "properties": {
        "type": {
          "const": "pdf_form"
        },
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "stage",
          "input_text",
          "evidence_text",
          "status"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "pattern": "^stage_(0[1-9]|10)$"
          },
          "input_text": {
            "type": "string"
          },
          "evidence_text": {
            "type": "string"
          },
          "status": {
            "const": "worksheet_draft"
          }
        }
      }
    },
    "mode": {
      "const": "offline_dry_run"
    },
    "external_writes": {
      "const": 0
    }
  }
}